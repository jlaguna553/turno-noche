{
  "name": "turno-noche",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "TURNO NOCHE: juego de terror en primera persona, PWA instalable y offline. Three.js + Rapier, arte y audio 100% procedurales.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Javier Laguna",
  "license": "MIT",
  "homepage": "https://jlaguna553.github.io/turno-noche/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlaguna553/turno-noche.git"
  },
  "keywords": [
    "horror",
    "game",
    "pwa",
    "threejs",
    "webgl",
    "terror",
    "first-person",
    "offline"
  ]
}
